{
  "name": "vmg-chatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm lint:strict && next build",
    "build:push": "drizzle-kit push --force && pnpm lint:strict && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "index-knowledge": "dotenv -e .env.local --override -- tsx scripts/index-knowledge.ts",
    "index-knowledge:staging": "dotenv -e .env.staging.local --override -- tsx scripts/index-knowledge.ts",
    "index-knowledge:prod": "dotenv -e .env.production.local --override -- tsx scripts/index-knowledge.ts",
    "sync-knowledge": "dotenv -e .env.local --override -- tsx scripts/sync-knowledge.ts",
    "sync-knowledge:staging": "dotenv -e .env.staging.local --override -- tsx scripts/sync-knowledge.ts",
    "sync-knowledge:prod": "dotenv -e .env.production.local --override -- tsx scripts/sync-knowledge.ts",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "dotenv -e .env.local -- tsx scripts/seed.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.40",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/openai": "^1.4.4",
    "@mistralai/mistralai": "^1.14.1",
    "@qdrant/js-client-rest": "^1.17.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@vercel/functions": "^3.4.4",
    "ai": "^6.0.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "js-tiktoken": "^1.0.21",
    "katex": "^0.16.45",
    "lucide-react": "^0.562.0",
    "next": "16.2.4",
    "openai": "^6.15.0",
    "p-limit": "^7.3.0",
    "pdf-extraction": "^1.0.2",
    "postgres": "^3.4.9",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
